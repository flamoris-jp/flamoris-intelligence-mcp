# Documentation only. Copy to .env; Compose passes it to the existing Settings.
# Python package users must supply environment variables themselves.
# The image CMD explicitly chooses HTTP. Package default remains stdio.
FLAMORIS_INTELLIGENCE_TRANSPORT=streamable-http
FLAMORIS_INTELLIGENCE_HTTP_HOST=127.0.0.1
FLAMORIS_INTELLIGENCE_HTTP_PORT=8767
FLAMORIS_INTELLIGENCE_MCP_PATH=/mcp
# Host networking on Linux reaches the host's independently managed provider.
FLAMORIS_INTELLIGENCE_PROVIDER_URL=http://127.0.0.1:8081
FLAMORIS_INTELLIGENCE_MODELS='[{"id":"gpt-oss-20b","provider_model":"gpt-oss-20b","context_tokens":32768,"max_output_tokens":4096}]'
FLAMORIS_INTELLIGENCE_TIMEOUT_SECONDS=120
FLAMORIS_INTELLIGENCE_HEALTH_TIMEOUT_SECONDS=5
FLAMORIS_INTELLIGENCE_MAX_INPUT_BYTES=65536
FLAMORIS_INTELLIGENCE_MAX_RESPONSE_BYTES=1048576
FLAMORIS_INTELLIGENCE_MAX_OUTPUT_BYTES=262144
FLAMORIS_INTELLIGENCE_MAX_CONCURRENCY=1
# Optional provider bearer credential (not MCP client authentication).
# FLAMORIS_INTELLIGENCE_PROVIDER_API_KEY=
